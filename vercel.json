{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix frontend && npm install --prefix backend && npm run prisma:generate --prefix backend",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/receipts/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{pack/**,backend/node_modules/.prisma/**,backend/node_modules/@prisma/client/**}",
      "maxDuration": 60
    }
  }
}
